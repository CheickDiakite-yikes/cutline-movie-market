{
  "name": "cutline-movie-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "data:historical": "python3 scripts/build_historical_model.py",
    "test:historical": "python3 -m unittest tests/test_historical_model.py -v",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "npm run test:historical && npm run build && npm run test:sites"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
