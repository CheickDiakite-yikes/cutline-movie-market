{
  "name": "cutline-movie-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "data:historical": "python3 scripts/build_historical_model.py --all && python3 scripts/build_automatic_prior.py && python3 scripts/build_target_enrichment.py",
    "data:auto": "python3 scripts/build_automatic_prior.py",
    "data:enrichment": "python3 scripts/build_target_enrichment.py",
    "data:critic": "python3 scripts/build_critic_outcomes.py",
    "data:verify": "python3 scripts/verify_data_cache.py",
    "data:download": "bash scripts/download_all_data.sh",
    "test:historical": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:ui-data": "node --test tests/kalshi-adapter.test.mjs tests/automatic-model.test.mjs tests/ideas.test.mjs tests/swipe.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "npm run test:historical && npm run test:ui-data && npm run build && npm run test:sites"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
